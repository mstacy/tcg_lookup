# Required: Anthropic API key used by /api/identify
ANTHROPIC_API_KEY=

# Recommended: JustTCG API key for prices by condition (free plan: 100 requests/day).
# Without it, Magic cards fall back to Scryfall's Near Mint market price.
JUSTTCG_API_KEY=

# Optional: shared cache + rate limit across server instances (Upstash Redis; Vercel's KV_REST_API_* also work)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: protects /api/cron/refresh-prices (Vercel sends it automatically)
# CRON_SECRET=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_CHOOSER_MODEL=claude-opus-5-5
# CACHE_TTL_MS=86400000
# RATE_LIMIT_PER_MINUTE=20
# NEXT_PUBLIC_OPENCV_URL=https://cdn.jsdelivr.net/npm/@techstark/opencv-js@4.10.0-release.1/dist/opencv.js
